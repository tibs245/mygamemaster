#!/usr/bin/env bash
# entrypoint.sh — startup of the Discord gateway for a MJ Tonnerre campaign.
set -euo pipefail
export HOME={{ container_home }}

echo "▶ MJ Tonnerre — starting container"

# 1. Presence checks (config + persona mounted by Ansible/Quadlet)
[[ -f "$HOME/config.yaml" ]] || { echo "✗ config.yaml missing from $HOME"; exit 1; }
[[ -f "$HOME/SOUL.md" ]]     || echo "⚠ SOUL.md missing (default persona)"

# 2. Secrets expected via environment (injected by EnvironmentFile / --env-file)
: "${OPENROUTER_API_KEY:?OPENROUTER_API_KEY not set}"
: "${DISCORD_BOT_TOKEN:?DISCORD_BOT_TOKEN not set}"

# 3. Sanity: hermes binary present
command -v hermes >/dev/null || { echo "✗ hermes binary not found in PATH"; exit 1; }
hermes --version || true

# 4. Start the Discord gateway.
#    Hermes 0.16: `gateway run` (foreground, recommended in a container). The platform
#    (Discord) + token are read from config.yaml + DISCORD_BOT_TOKEN (env). Rootless:
#    container "root" = regular user on the host → gateway in container root is allowed.
echo "▶ Starting Discord gateway…"
export HERMES_ALLOW_ROOT_GATEWAY=1
exec hermes gateway run --accept-hooks
