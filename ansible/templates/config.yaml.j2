# config.yaml — campaign « {{ campaign_title }} »  (rendered by Ansible, do not edit by hand)
# Source of truth: ansible/templates/config.yaml.j2 + the games.yml table

model:
  default: {{ model | default(default_model) }}
  provider: {{ provider | default(default_provider) }}
  base_url: {{ base_url | default(default_base_url) }}
  api_mode: chat_completions

# Our modules in addition to the stock skills.
# Point to the folder that DIRECTLY CONTAINS the skills (each skill = a sub-folder
# with SKILL.md). Our modules live under gaming/ → list gaming/, not the
# root /opt/modules (the Hermes loader does not recurse: it looks for <dir>/<skill>/SKILL.md).
skills:
  external_dirs:
    - {{ container_modules }}/gaming
  template_vars: true

# The agent runs its skill scripts in its own container; cwd = campaign data
terminal:
  backend: local
  cwd: {{ container_data_root }}/{{ campaign_data_dir }}
  persistent_shell: true
  auto_source_bashrc: true

agent:
  max_turns: 90
  reasoning_effort: medium
  tool_use_enforcement: auto

# Agent memory ceilings. Hermes counts ~2.75 chars/token, so 6000/4000 ≈ 2200/1450
# tokens — the snapshot is frozen for the whole session and lands in the cached
# prefix, so the real per-turn cost after the first call is marginal.
# The former 2200/1375 were hard-coded here with no per-table override: the user
# profile ran at 88% of its ceiling (98% as early as June 16) and produced 318
# capacity refusals, which is what forced the oversized `replace` payloads the
# model then truncated (docs/10-field-report.md).
# Override per game: a `memory_char_limit:` field in the games.yml entry (mapped by
# hermes_inventory.py) or `host_vars/<slug>.yml`. A ceiling is only useful with the
# entry-format card injected by pre_llm_call.py — raising it alone just moves the
# breaking point.
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: {{ memory_char_limit | default(6000) }}
  user_char_limit: {{ user_char_limit | default(4000) }}
  nudge_interval: {{ memory_nudge_interval | default(10) }}

# Transcript compression + skill curator: both ran on Hermes defaults nobody chose.
# threshold 0.50 summarised the transcript LOSSILY at half the window — the GM lost
# the detail of its own session mid-game. prune_builtins: true is what took the skill
# set 78 → 31 and, on the 26/07 pass, absorbed the player-preferences skill precisely
# BECAUSE it was loaded before every turn.
# The curator stays ON: it is the only thing keeping SKILL.md under the platform's
# non-configurable 100 000-char write freeze.
compression:
  threshold: {{ compression_threshold | default(0.75) }}
  protect_last_n: {{ compression_protect_last_n | default(40) }}

curator:
  enabled: true
  prune_builtins: false
  stale_after_days: {{ curator_stale_after_days | default(90) }}

display:
  interface: cli
  language: {{ language | default(default_language) }}
  streaming: true
  platforms:
    discord:
      streaming: false

discord:
  require_mention: true
  auto_thread: true
  thread_require_mention: false
  history_backfill: true
  history_backfill_limit: 50
  reactions: true

security:
  redact_secrets: true

logging:
  level: INFO

# ── MJ Tonnerre runtime hooks (Steward / verbosity / systematic traceability) ──
# Scripts baked into the image (COPY modules/), invoked via explicit interpreter.
# Per-campaign fine-tuning in world.json > meta.{verbosity,diagnostic,admins,hooks}.
# Global disable: set hooks_enabled: false in the games.yml table.
# Spec: specs/hooks-runtime.md — Doc: docs/09-runtime-hooks.md
{% if hooks_enabled | default(true) %}
{% set hooks_py = hooks_python | default('/opt/hermes/venv/bin/python3') %}
{% set hooks_dir = container_modules ~ '/gaming/mygamemaster/hooks' %}
hooks:
  pre_llm_call:
    - command: "{{ hooks_py }} {{ hooks_dir }}/pre_llm_call.py"
      timeout: 10
  pre_tool_call:
    - matcher: "write_file|patch|edit|apply_patch|str_replace"
      command: "{{ hooks_py }} {{ hooks_dir }}/pre_tool_call.py"
      timeout: 10
  post_tool_call:
    - matcher: "write_file|patch|edit|apply_patch|str_replace"
      command: "{{ hooks_py }} {{ hooks_dir }}/post_tool_call.py"
      timeout: 10
  transform_llm_output:
    - command: "{{ hooks_py }} {{ hooks_dir }}/transform_llm_output.py"
      # 45 s: headroom for auto-TTS (format + Minimax synthesis + ambient mix) when
      # the `tts` axis is ON and the key is present. Without TTS, the hook stays under ~150 ms.
      # Generation itself is capped by MGM_TTS_TIMEOUT (default 40 s) on the hook side.
      timeout: 45
  on_session_end:
    - command: "{{ hooks_py }} {{ hooks_dir }}/on_session_end.py"
      timeout: 30
# Non-interactive in container (otherwise a consent prompt appears on the first run of each hook).
hooks_auto_accept: true
{% else %}
hooks: {}
hooks_auto_accept: false
{% endif %}
