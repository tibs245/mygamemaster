# ───────────────────────────────────────────────────────────────────────
# .gitignore — MJ Tonnerre mono-repo
# Protects secrets, runtime state, the local game table, and real game data.
# Only the *.example.* files are committed; the real ones stay local.
# ───────────────────────────────────────────────────────────────────────

# --- Source archive (safety net, NEVER committed) ---
/archive_hermes/

# --- Timestamped backups (large, local) ---
/backups/

# --- Secrets ---
/.env
**/.env
!/.env.example
*.env.local
# encrypted real vault — kept local, only vault.example.yml is committed
ansible/inventory/group_vars/all/vault.yml
ansible/inventory/group_vars/all/secrets.yml
ansible/inventory/group_vars/all/vault_open.yml
ansible/**/*.key
ansible/.vault_pass
.vault_pass

# --- Game table & inventory (the real ones are local; only *.example.* committed) ---
ansible/inventory/games.yml
ansible/inventory/hosts.yml
ansible/inventory/host_vars/

# --- Real game data (kept local as reference; only _template/ and example-* committed) ---
/data/mj-tonnerre/campagnes/la-naissance-dun-roi/
/data/mj-tonnerre/campagnes/jusquau-bout-de-mon-monde/

# --- Local editor/agent settings (may contain host IPs, paths) ---
.claude/settings.local.json

# --- macOS artifacts (AppleDouble) ---
._*
.DS_Store

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Logs / runtime state possibly copied by mistake ---
*.log
*.pid
*.lock
state.db*
kanban.db*
gateway_state.json
channel_directory.json
discord_threads.json

# --- Steward hooks runtime state (ledger, pending, snapshots) — never committed ---
.banquier/

# --- Ansible runtime ---
*.retry

# --- Playbook-generated artifacts ---
/.rendered/
/.build/
