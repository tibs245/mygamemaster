# ─────────────────────────────────────────────────────────────────────────────
# .env.example — local API keys for the build/test harness and ad-hoc scripts.
#
# Copy to .env and fill in your own keys. NEVER commit .env (it is git-ignored).
# These are for LOCAL tooling only. The DEPLOYED game instances read their
# secrets from the Ansible vault (see ansible/inventory/group_vars/all/
# vault.example.yml), not from this file.
# ─────────────────────────────────────────────────────────────────────────────

# LLM access (OpenRouter) — required for the model the GM runs on.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Narrative voice (MiniMax TTS) — OPTIONAL. Absent = no voice; the miss is reported
# (hook journal + tts_doctor.py), never passed off as "the feature is disabled".
MINIMAX_API_KEY=REPLACE_ME

# Automatic voice in the transform_llm_output hook — OPT-IN, default off.
# `!raconte` works without it. Why it is off, and how to check that turning it on
# actually produced audio: modules/gaming/mygamemaster-tts/SKILL.md § B.
# MGM_TTS_AUTO=1
