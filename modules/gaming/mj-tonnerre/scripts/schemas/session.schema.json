{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mj-tonnerre/session.schema.json",
  "title": "sessions/NNN.json — log d'une session",
  "type": "object",
  "required": ["session", "date", "participants", "actions", "pnj_rencontres", "lieux_visites"],
  "additionalProperties": true,
  "properties": {
    "session": { "type": ["integer", "string"] },
    "date": {
      "type": ["string", "null"],
      "description": "null tant que la session n'est pas clôturée ; daté à la clôture."
    },
    "heure_debut": { "type": ["string", "null"] },
    "heure_fin": {
      "type": ["string", "null"],
      "description": "null/vide tant que la session n'est pas clôturée ; rempli à la clôture."
    },
    "titre_episode": { "type": ["string", "null"] },
    "resume": { "type": ["string", "null"] },
    "participants": { "type": "array" },
    "actions": {
      "type": "array",
      "description": "Deux formes historiques tolérées : {joueur,action,resultat} (S1-S7) et {timestamp,type,joueur,description,...} (S8+, canonique via add_action.py). Chaque entrée porte au moins 'action' ou 'description'.",
      "items": {
        "type": "object",
        "anyOf": [
          { "required": ["action"] },
          { "required": ["description"] }
        ],
        "properties": {
          "joueur": { "type": "string" },
          "action": { "type": "string" },
          "description": { "type": "string" },
          "resultat": { "type": "string" },
          "timestamp": { "type": "string" },
          "type": { "type": "string" },
          "details": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "pnj_rencontres": { "type": "array" },
    "lieux_visites": { "type": "array" },
    "etat_fin": { "type": ["object", "null"] },
    "teaser": { "type": "string" }
  }
}
