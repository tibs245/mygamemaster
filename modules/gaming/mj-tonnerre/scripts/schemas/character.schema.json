{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mj-tonnerre/personnage.schema.json",
  "title": "characters/<id>.json — fiche d'un personnage joueur",
  "type": "object",
  "required": ["meta", "stats", "inventory", "health"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["character_name"],
      "additionalProperties": true,
      "properties": {
        "character_name": { "type": "string" },
        "discord_id": { "type": ["string", "integer"] }
      }
    },
    "stats": { "type": "object" },
    "inventory": { "type": "array" },
    "skills": { "type": ["array", "object"] },
    "health": {
      "type": "object",
      "additionalProperties": true,
      "description": "PV / seuils de blessure. Champs exacts variables selon le système."
    },
    "progression": { "type": ["object", "array"] }
  }
}
