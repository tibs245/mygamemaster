{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mj-tonnerre/personnage.schema.json",
  "title": "personnages/<id>.json — fiche d'un personnage joueur",
  "type": "object",
  "required": ["meta", "stats", "inventaire", "sante"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["nom_perso"],
      "additionalProperties": true,
      "properties": {
        "nom_perso": { "type": "string" },
        "discord_id": { "type": ["string", "integer"] }
      }
    },
    "stats": { "type": "object" },
    "inventaire": { "type": "array" },
    "competences": { "type": ["array", "object"] },
    "sante": {
      "type": "object",
      "additionalProperties": true,
      "description": "PV / seuils de blessure. Champs exacts variables selon le système."
    },
    "progression": { "type": ["object", "array"] },
    "preferences": {
      "type": "object",
      "additionalProperties": true,
      "description": "Préférences de jeu méta/hors-fiction propres au joueur (rythme, ton, verbosité combat, spotlight, limites de contenu, aime_etre_trompe, custom). Toutes optionnelles — ré-injectées au MJ à chaque tour (fail-open)."
    }
  }
}
