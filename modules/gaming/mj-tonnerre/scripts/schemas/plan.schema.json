{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mj-tonnerre/plan.schema.json",
  "title": "plan — liste ordonnée d'intentions datées d'un acteur (monde vivant)",
  "description": "Le plan est la généralisation de faction_actions_horloge (doc 02 §1, contrat §6.1). C'est une LISTE d'intentions (peut être []) datées en T (UT), que le moteur de tick consomme et que le pré-traitement projette sur le joueur. Chaque id 'intent:<slug>' est unique au sein du plan. Ce schéma valide un plan ISOLÉ ; la définition d'intention est embarquée ($defs.intention) pour rester autoportante (le validateur maison ne résout que les $ref locaux). Elle est tenue STRICTEMENT cohérente avec intention.schema.json.",
  "type": "array",
  "items": { "$ref": "#/$defs/intention" },
  "$defs": {
    "intention": {
      "type": "object",
      "description": "Intention atomique (cf. intention.schema.json — même contrat §6.2).",
      "required": ["id", "action", "lieu", "echeance", "consequence_attendue", "visible_par_pj", "statut"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant 'intent:<slug>' unique dans le plan."
        },
        "action": { "type": "string", "description": "Quoi : libellé de l'action." },
        "lieu": {
          "type": ["string", "null"],
          "description": "id de lieu cible, ou null si non spatial."
        },
        "echeance": {
          "type": "integer",
          "description": "T (UT) au plus tard — entier déterministe (borne haute si fourchette)."
        },
        "echeance_source": {
          "description": "Échéance épinglée d'origine (trace) — objet clock.py OU chaîne libre. Optionnel.",
          "oneOf": [
            {
              "type": "object",
              "required": ["texte", "unite", "ancre"],
              "additionalProperties": true,
              "properties": {
                "texte": { "type": "string" },
                "unite": { "type": "string", "enum": ["jour", "ut"] },
                "min": { "type": ["integer", "null"] },
                "max": { "type": ["integer", "null"] },
                "ancre": { "type": "integer" },
                "statut": {
                  "type": "string",
                  "enum": ["en_cours", "echue", "resolue"]
                }
              }
            },
            { "type": "string" }
          ]
        },
        "preconditions": {
          "type": "array",
          "description": "Comparaisons numériques 'ressources.<clef> <op> <nombre>'. Inconnu → True (fail-open). Optionnel.",
          "items": { "type": "string" }
        },
        "consequence_attendue": {
          "type": "string",
          "description": "Effets attendus (texte). Amorce la propagation si significatif."
        },
        "consequence_effets": {
          "type": "object",
          "description": "Deltas machine optionnels (ressources/relations/evenement) appliqués par le Banquier étendu.",
          "additionalProperties": true,
          "properties": {
            "ressources": { "type": "object", "additionalProperties": true },
            "relations": {
              "type": "array",
              "items": { "$ref": "#/$defs/relation_effet" }
            },
            "evenement": { "type": "object", "additionalProperties": true }
          }
        },
        "significativite": {
          "type": "number",
          "description": "0–1 : amorce de propagation. Défaut applicatif 0.5."
        },
        "visible_par_pj": {
          "type": "boolean",
          "description": "Le PJ peut-il observer cette intention ?"
        },
        "statut": {
          "type": "string",
          "description": "Cycle de vie.",
          "enum": ["planifie", "en_cours", "accompli", "echoue", "annule"]
        }
      }
    },
    "relation_effet": {
      "type": "object",
      "description": "Mutation de relation embarquée dans une conséquence (cf. relation.schema.json).",
      "required": ["vers", "type"],
      "additionalProperties": true,
      "properties": {
        "vers": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "approvisionnement",
            "vassalite",
            "alliance",
            "hostilite",
            "route_commerciale",
            "parente",
            "rivalite",
            "predation",
            "commandement",
            "trahison",
            "concurrence",
            "tutelle"
          ]
        },
        "intensite": { "type": "number" },
        "bien": { "type": "string" },
        "part": { "type": "number" },
        "delai_ut": { "type": "integer" },
        "poids": { "type": "number" }
      }
    }
  }
}
