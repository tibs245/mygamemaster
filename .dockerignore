# .dockerignore — keep the dev image lean and secret-free

# Version control
.git
.gitignore

# Runtime archives and backups (large, never needed in the image)
archive_hermes/
backups/

# Build artefacts
.build/
.rendered/

# Secrets — NEVER bake into the image
# Exclude all *.env files (prod.env, staging.env, .env, *.env.local, etc.)
# but keep *.env.example files so they can serve as documentation.
*.env
!*.env.example
ansible/inventory/group_vars/all/vault.yml
ansible/inventory/group_vars/all/secrets.yml
ansible/inventory/group_vars/all/vault_open.yml
ansible/**/*.key
ansible/.vault_pass
.vault_pass

# Real campaign data (local only, git-ignored)
data/mygamemaster/campaigns/la-naissance-dun-roi/
data/mygamemaster/campaigns/jusquau-bout-de-mon-monde/
data/mygamemaster/campaigns/nouvelle-marche/
# Legacy pre-rename campaign tree — git-ignored, but `COPY . .` would still bake it in.
data/mj-tonnerre/

# Legacy pre-rename module tree. Only local runtime artefacts survive there (Steward ledgers,
# __pycache__, jets.log) — no source. They are git-ignored, so `COPY . .` would bake stale
# ledgers and caches into the image while contributing nothing.
modules/gaming/mj-tonnerre/
modules/gaming/mj-tonnerre-images/
modules/gaming/mj-tonnerre-tts/

# Python cache
__pycache__/
*.pyc
.venv/

# macOS artefacts
._*
.DS_Store

# Editor / agent settings
.claude/
